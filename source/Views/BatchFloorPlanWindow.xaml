<Window x:Class="DSCons.Revit.Starter.Views.BatchFloorPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="820"
        Height="720"
        MinWidth="740"
        MinHeight="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Banner Header -->
            <RowDefinition Height="82" />
            <!-- 1: User Selection & View Range Specs -->
            <RowDefinition Height="Auto" />
            <!-- 2: Body 2-Column Lists -->
            <RowDefinition Height="*" />
            <!-- 3: Footer Status & Actions -->
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- 0: BANNER HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BIM TOOL · MEP AUTOMATION SUITE"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Opacity="0.85" />
                    <TextBlock Text="Tạo Mặt Bằng MEP Tự Động"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,1,0,1" />
                    <TextBlock Text="{Binding DocumentTitle, StringFormat='Mô hình: {0} · Chuẩn hóa 13 hệ thống &amp; View Range đồng bộ'}"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               Opacity="0.90"
                               FontSize="11" />
                </StackPanel>

                <!-- BRANDING BADGE -->
                <Border Grid.Column="1"
                        Background="{DynamicResource AccentDarkBrush}"
                        CornerRadius="6"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StudentName}"
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Company}"
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   Opacity="0.85"
                                   FontSize="10"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 1: USER SELECTION & VIEW RANGE SPECS -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- USER SELECTION -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Người dùng phụ trách (User):"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="#1E293B"
                               Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}"
                              DisplayMemberPath="DisplayName"
                              Height="32"
                              VerticalContentAlignment="Center"
                              Padding="8,0"
                              Background="White"
                              BorderBrush="#CBD5E1" />
                    <TextBlock Text="Tiền tố tên View sẽ bắt đầu bằng mã User này"
                               FontSize="10.5"
                               Foreground="#64748B"
                               Margin="2,4,0,0" />
                </StackPanel>

                <!-- VIEW RANGE SPECS CARD -->
                <Border Grid.Column="2"
                        Background="#F1F5F9"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="📐 THIẾT LẬP VIEW RANGE CỐ ĐỊNH CHUẨN HÓA"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Foreground="#334155"
                                   Margin="0,0,0,4" />
                        <UniformGrid Grid.Row="1" Columns="4">
                            <StackPanel Margin="2,0">
                                <TextBlock Text="Top Clip Plane" FontSize="10" Foreground="#64748B" />
                                <TextBlock Text="Level Above (0 mm)" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" />
                            </StackPanel>
                            <StackPanel Margin="2,0">
                                <TextBlock Text="Cut Plane" FontSize="10" Foreground="#64748B" />
                                <TextBlock Text="Level (1,200 mm)" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" />
                            </StackPanel>
                            <StackPanel Margin="2,0">
                                <TextBlock Text="Bottom Clip" FontSize="10" Foreground="#64748B" />
                                <TextBlock Text="Level (0 mm)" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" />
                            </StackPanel>
                            <StackPanel Margin="2,0">
                                <TextBlock Text="View Depth" FontSize="10" Foreground="#64748B" />
                                <TextBlock Text="Level (0 mm)" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" />
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 2: BODY 2-COLUMN LISTS (LEVELS & SYSTEMS) -->
        <Grid Grid.Row="2" Margin="18,12,18,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: DANH SÁCH TẦNG (LEVELS) -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header Tầng -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DANH SÁCH TẦNG (LEVELS)"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="#1E293B"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Tất cả"
                                    Command="{Binding SelectAllLevelsCommand}"
                                    Padding="8,2"
                                    Margin="0,0,4,0"
                                    FontSize="10.5" />
                            <Button Content="Bỏ chọn"
                                    Command="{Binding UnselectAllLevelsCommand}"
                                    Padding="8,2"
                                    FontSize="10.5" />
                        </StackPanel>
                    </Grid>

                    <!-- ListBox Tầng -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Levels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9"
                                            BorderThickness="0,0,0,1"
                                            Padding="4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="65" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11.5"
                                                           Foreground="#1E293B" />
                                                <TextBlock Text="{Binding ElevationDisplay}"
                                                           FontSize="10"
                                                           Foreground="#64748B" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="Mã:"
                                                       FontSize="10.5"
                                                       Foreground="#64748B"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,4,0" />

                                            <TextBox Grid.Column="3"
                                                     Text="{Binding LevelCode, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center"
                                                     FontWeight="Bold"
                                                     FontSize="11"
                                                     HorizontalContentAlignment="Center"
                                                     Padding="2"
                                                     BorderBrush="#CBD5E1" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CỘT PHẢI: DANH SÁCH 13 HỆ THỐNG MEP -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header Hệ thống -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="13 PHÂN HỆ MEP CHUẨN HÓA"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="#1E293B"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Tất cả (13 hệ)"
                                    Command="{Binding SelectAllSystemsCommand}"
                                    Padding="8,2"
                                    Margin="0,0,4,0"
                                    FontSize="10.5" />
                            <Button Content="Bỏ chọn"
                                    Command="{Binding UnselectAllSystemsCommand}"
                                    Padding="8,2"
                                    FontSize="10.5" />
                        </StackPanel>
                    </Grid>

                    <!-- ListBox Hệ thống -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MepSystems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9"
                                            BorderThickness="0,0,0,1"
                                            Padding="4,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />

                                            <!-- Badge mã hệ -->
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource AccentLightBrush}"
                                                    CornerRadius="4"
                                                    Padding="4,2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Code}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AccentDarkBrush}" />
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding EnglishName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="#1E293B" />
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="10"
                                                           Foreground="#64748B" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 3: FOOTER STATUS & ACTION BAR -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Tóm tắt & Status -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PreviewSummary}"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="#0F172A" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🚀 TẠO VIEW MẶT BẰNG"
                            Command="{Binding ExecuteCreateViewsCommand}"
                            Style="{DynamicResource PrimaryButton}"
                            Height="38"
                            MinWidth="200"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Margin="0,0,8,0" />
                    <Button Content="Đóng"
                            Command="{Binding CloseCommand}"
                            Height="38"
                            MinWidth="75"
                            FontSize="11.5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
